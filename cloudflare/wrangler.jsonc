{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-bot-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-bot-tracker", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "RETENTION_DAYS": "90" },
  "durable_objects": { "bindings": [{ "name": "HASHER", "class_name": "PasswordHasher" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PasswordHasher"] }],
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
