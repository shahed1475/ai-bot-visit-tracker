{
    "name": "ai-bot-tracker/php-middleware",
    "description": "PHP middleware for detecting and logging AI bot visits",
    "type": "library",
    "keywords": ["ai", "bot", "tracking", "middleware", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "AI Bot Tracker",
            "email": "info@example.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "AiBotTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiBotTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}